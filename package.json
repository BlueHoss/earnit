{
	"name": "earn-it",
	"version": "0.0.2",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"build:staging": "NODE_ENV=staging vite build",
		"preview:staging": "vite preview --mode staging",
		"start:staging": "NODE_ENV=staging node build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"studio": "drizzle-kit studio --config drizzle.config.ts",
		"db:generate": "npx drizzle-kit generate --config drizzle.config.ts",
		"db:push": "npx drizzle-kit push --config drizzle.config.ts"
	},
	"devDependencies": {
		"@stripe/stripe-js": "^3.5.0",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/adapter-vercel": "^5.4.3",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@types/eslint": "^9.6.0",
		"@types/nodemailer": "^6.4.14",
		"@types/pg": "^8.11.1",
		"@types/uuid": "^10.0.0",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"autoprefixer": "^10.4.20",
		"dotenv": "^16.4.5",
		"drizzle-kit": "^0.22.0",
		"drizzle-orm": "^0.33.0",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.43.0",
		"postcss": "^8.4.41",
		"postcss-load-config": "^4.0.1",
		"prettier": "^3.0.0",
		"prettier-plugin-tailwindcss": "^0.4.1",
		"stripe": "^16.11.0",
		"svelte": "^4.2.7",
		"svelte-check": "^3.6.0",
		"svelte-stripe": "^1.2.0",
		"sveltekit-flash-message": "^2.3.1",
		"sveltekit-superforms": "^2.17.0",
		"tailwindcss": "^3.4.10",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^5.0.3",
		"zod": "^3.23.8"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-ses": "^3.470.0",
		"@axiomhq/js": "^1.0.0-rc.1",
		"@eslint/js": "^9.9.0",
		"@internationalized/date": "^3.5.0",
		"@lucia-auth/adapter-drizzle": "^1.0.2",
		"@supabase/supabase-js": "^2.45.2",
		"@tailwindcss/typography": "^0.5.14",
		"arctic": "^1.2.0",
		"bits-ui": "^0.21.13",
		"clsx": "^2.1.1",
		"cmdk-sv": "^0.0.12",
		"defang": "^0.5.38",
		"eslint-js": "github:eslint/js",
		"formsnap": "^1.0.1",
		"g": "^2.0.1",
		"globals": "^15.9.0",
		"lucia": "^3.0.1",
		"lucide-svelte": "^0.427.0",
